<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeColor="@color/divider"
            app:strokeWidth="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.SplitSmart.Caption"
                    android:text="@string/you_owe" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.SplitSmart.Title"
                    android:textSize="22sp"
                    android:textColor="@color/primary"
                    android:layout_marginTop="10dp"
                    android:id="@+id/tvToPay" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeColor="@color/divider"
            app:strokeWidth="0dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.SplitSmart.Caption"
                    android:text="@string/you_are_owed" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.SplitSmart.Title"
                    android:textSize="22sp"
                    android:layout_marginTop="10dp"
                    android:id="@+id/tvToReceive" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
    <com.google.android.material.button.MaterialButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/create_settlement"
        android:layout_marginTop="8dp"
        app:icon="@drawable/ic_swap"
        app:iconGravity="textStart"
        android:id="@+id/btnCreateSettlement"
        android:minHeight="48dp"
        android:layout_gravity="end"
        android:minWidth="120dp"
        style="@style/Widget.SplitSmart.Button.TextButton" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.SplitSmart.Section"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:text="@string/group_balances" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.SplitSmart.Body"
        android:gravity="center"
        android:padding="24dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/background_card"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        android:text="@string/all_settled"
        android:id="@+id/tvEmpty" />
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:id="@+id/progress"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        android:indeterminate="true"
        app:indicatorSize="28dp"
        app:trackThickness="3dp"
        app:indicatorInset="2dp" />
    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="112dp"
        android:id="@+id/rvBalances" />
</LinearLayout>
