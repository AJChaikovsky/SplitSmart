<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <com.google.android.material.button.MaterialButton
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:id="@+id/btnMembers"
            android:text="@string/members"
            style="@style/Widget.SplitSmart.Button.TextButton"
            android:minHeight="48dp"
            android:layout_marginStart="12dp"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            app:icon="@drawable/ic_group"
            app:iconTint="@color/text_secondary"
            app:iconSize="16dp"
            app:iconGravity="textStart" />
        <com.google.android.material.tabs.TabLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:id="@+id/groupTabs"
            android:background="@color/background"
            app:tabMode="fixed"
            app:tabGravity="fill"
            app:tabTextAppearance="@style/TextAppearance.SplitSmart.Section"
            app:tabTextColor="@color/group_tab_text"
            app:tabSelectedTextColor="@color/primary"
            app:tabIndicatorColor="@color/primary"
            app:tabIndicatorHeight="2dp"
            app:tabIndicatorFullWidth="false"
            app:tabPaddingStart="12dp"
            app:tabPaddingEnd="12dp" />
        <androidx.fragment.app.FragmentContainerView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:id="@+id/groupContent"
            android:layout_weight="1" />
    </LinearLayout>
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:id="@+id/btnAddExpense"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:text="@string/add_expense"
        android:contentDescription="@string/add_expense"
        style="@style/Widget.SplitSmart.ExtendedFloatingActionButton"
        app:icon="@drawable/ic_plus" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
