<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/surface" app:strokeColor="@color/divider" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="48dp" android:layout_height="48dp" android:textAppearance="@style/TextAppearance.SplitSmart.Body" android:gravity="center" android:background="@drawable/background_avatar" android:textColor="@color/primary" android:textSize="15sp" android:textStyle="bold" android:id="@+id/tvGroupAvatar" android:importantForAccessibility="no" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="14dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.SplitSmart.Title" android:textSize="20sp" android:id="@+id/tvName" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.SplitSmart.Caption" android:layout_marginTop="6dp" android:id="@+id/tvDescription" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/add_expense" android:layout_marginTop="18dp" app:icon="@drawable/ic_plus" app:iconGravity="textStart" android:id="@+id/btnAddExpense" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp" android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/balances" android:layout_weight="1" app:icon="@drawable/ic_wallet" style="@style/Widget.SplitSmart.Button.Shortcut" android:id="@+id/btnBalances" />
            <com.google.android.material.button.MaterialButton android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/history" android:layout_weight="1" android:layout_marginStart="8dp" app:icon="@drawable/ic_history" style="@style/Widget.SplitSmart.Button.Shortcut" android:id="@+id/btnHistory" />
            <com.google.android.material.button.MaterialButton android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/overview" android:layout_weight="1" android:layout_marginStart="8dp" app:icon="@drawable/ic_chart" android:contentDescription="@string/monthly_summary" style="@style/Widget.SplitSmart.Button.Shortcut" android:id="@+id/btnSummary" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.SplitSmart.Section" android:layout_weight="1" android:text="@string/members" />
            <com.google.android.material.button.MaterialButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/edit_group" style="@style/Widget.SplitSmart.Button.TextButton" android:id="@+id/btnEditGroup" />
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/surface" app:strokeColor="@color/divider" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/llMemberList" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddFromFriends"
                    style="@style/Widget.SplitSmart.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/add_from_friends"
                    android:visibility="gone" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp" android:gravity="center_vertical" android:id="@+id/layoutAddMember">
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="@string/member_email">
                        <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" android:id="@+id/etMemberEmail" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/add_short" android:layout_marginStart="8dp" android:minWidth="64dp" android:paddingHorizontal="12dp" android:id="@+id/btnAddMember" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnLeaveGroup" style="@style/Widget.SplitSmart.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/leave_group" android:textColor="@color/error" app:strokeColor="@color/error" android:visibility="gone" />
        <com.google.android.material.progressindicator.CircularProgressIndicator android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:visibility="gone" android:indeterminate="true" app:indicatorSize="28dp" app:trackThickness="3dp" app:indicatorColor="@color/primary" android:id="@+id/progress" app:indicatorInset="2dp" />
    </LinearLayout>
</ScrollView>
