<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/surface"
    app:strokeColor="@color/divider"
    app:strokeWidth="0dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:textAppearance="@style/TextAppearance.SplitSmart.Body"
            android:gravity="center"
            android:background="@drawable/background_avatar"
            android:textColor="@color/primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:id="@+id/tvAvatar"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_marginStart="14dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SplitSmart.Section"
                android:textSize="15sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:id="@+id/tvName" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SplitSmart.Caption"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:id="@+id/tvDescription" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SplitSmart.Caption"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_secondary"
                android:id="@+id/tvMembers" />
        </LinearLayout>
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            android:importantForAccessibility="no"
            android:layout_marginStart="8dp"
            app:tint="@color/text_secondary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
