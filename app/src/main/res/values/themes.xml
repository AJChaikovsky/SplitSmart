<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SplitSmart.Base" parent="Theme.MaterialComponents.DayNight">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:windowAnimationStyle">@style/Animation.SplitSmart</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorSecondaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorAccent">@color/primary</item>
        <item name="colorControlActivated">@color/primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:navigationBarColor">@color/legacy_navigation_bar</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textViewStyle">@style/Widget.SplitSmart.TextView</item>
        <item name="android:editTextStyle">@style/Widget.SplitSmart.EditText</item>
        <item name="editTextStyle">@style/Widget.SplitSmart.EditText</item>
        <item name="checkboxStyle">@style/Widget.SplitSmart.CheckBox</item>
        <item name="actionBarSize">56dp</item>
        <item name="actionBarStyle">@style/Widget.SplitSmart.ActionBar</item>
        <item name="materialButtonStyle">@style/Widget.SplitSmart.Button</item>
        <item name="textInputStyle">@style/Widget.SplitSmart.TextInputLayout</item>
        <item name="floatingActionButtonStyle">@style/Widget.SplitSmart.FloatingActionButton</item>
        <item name="textAppearanceBody1">@style/TextAppearance.SplitSmart.Body</item>
        <item name="textAppearanceBody2">@style/TextAppearance.SplitSmart.Caption</item>
        <item name="textAppearanceButton">@style/TextAppearance.SplitSmart.Button</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>
    <style name="TextAppearance.SplitSmart.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.SplitSmart.Caption" parent="TextAppearance.SplitSmart.Body">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
    <style name="TextAppearance.SplitSmart.Title" parent="TextAppearance.SplitSmart.Body">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="TextAppearance.SplitSmart.Section" parent="TextAppearance.SplitSmart.Body">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.SplitSmart.Button" parent="TextAppearance.SplitSmart.Body">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.SplitSmart.Amount" parent="TextAppearance.SplitSmart.Title">
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <!-- Small all-caps section label; caps always get positive tracking. -->
    <style name="TextAppearance.SplitSmart.Eyebrow" parent="TextAppearance.SplitSmart.Body">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="Widget.SplitSmart.TextView" parent="android:Widget.TextView">
        <item name="android:textAppearance">@style/TextAppearance.SplitSmart.Body</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="Widget.SplitSmart.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>
    <style name="Widget.SplitSmart.CheckBox" parent="Widget.MaterialComponents.CompoundButton.CheckBox">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="buttonTint">@color/control_tint</item>
    </style>
    <style name="Widget.SplitSmart.ActionBar" parent="Widget.MaterialComponents.ActionBar.Solid">
        <item name="background">@drawable/background_action_bar</item>
        <item name="elevation">0dp</item>
        <item name="titleTextStyle">@style/TextAppearance.SplitSmart.ActionBar.Title</item>
        <item name="subtitleTextStyle">@style/TextAppearance.SplitSmart.ActionBar.Subtitle</item>
    </style>
    <style name="TextAppearance.SplitSmart.ActionBar.Subtitle" parent="TextAppearance.Widget.AppCompat.Toolbar.Subtitle">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="TextAppearance.SplitSmart.ActionBar.Title" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.SplitSmart.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAppearance">@style/TextAppearance.SplitSmart.Button</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">8dp</item>
        <item name="android:insetTop">6dp</item>
        <item name="android:insetBottom">6dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/primary_button_content</item>
        <item name="iconTint">@color/primary_button_content</item>
    </style>
    <style name="Widget.SplitSmart.Button.OutlinedButton" parent="Widget.SplitSmart.Button.TextButton">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="strokeColor">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="iconSize">18dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
    <style name="Widget.SplitSmart.Button.TextButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:textColor">@color/neutral_button_content</item>
        <item name="iconTint">@color/neutral_button_content</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="iconSize">18dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
    <style name="Widget.SplitSmart.Button.Shortcut" parent="Widget.SplitSmart.Button.OutlinedButton">
        <item name="android:textColor">@color/text_primary</item>
        <item name="iconTint">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">6dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="iconSize">16dp</item>
    </style>
    <style name="Widget.SplitSmart.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="hintTextAppearance">@style/TextAppearance.SplitSmart.Caption</item>
    </style>
    <style name="Widget.SplitSmart.FloatingActionButton" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/accent</item>
        <item name="tint">@color/on_accent</item>
        <item name="elevation">2dp</item>
        <item name="borderWidth">0dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.SplitSmart.Fab</item>
    </style>
    <style name="ShapeAppearanceOverlay.SplitSmart.Fab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>
    <style name="Widget.SplitSmart.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/background_dropdown</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">32dp</item>
        <item name="android:popupBackground">@drawable/background_card</item>
        <item name="android:dropDownWidth">match_parent</item>
    </style>
    <style name="Animation.SplitSmart" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/screen_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/screen_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/screen_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/screen_exit</item>
    </style>
    <style name="Theme.SplitSmart" parent="Theme.SplitSmart.Base" />
    <style name="Theme.SplitSmart.NoActionBar" parent="Theme.SplitSmart">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    <style name="Widget.SplitSmart.ExtendedFloatingActionButton" parent="Widget.MaterialComponents.ExtendedFloatingActionButton">
        <item name="backgroundTint">@color/accent</item>
        <item name="iconTint">@color/on_accent</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">56dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">8dp</item>
        <item name="elevation">3dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.SplitSmart.Fab</item>
    </style>
    <style name="Theme.SplitSmart.Group" parent="Theme.SplitSmart">
        <item name="actionBarSize">48dp</item>
    </style>
</resources>
