rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isGroupOwner(groupId) {
      return signedIn()
        && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid;
    }

    function isGroupMember(groupId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.email == resource.data.email
        && request.resource.data.uscId == resource.data.uscId;
      allow delete: if false;
    }

    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid
        || request.auth.uid in resource.data.memberIds
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /expenses/{expenseId} {
      allow read: if signedIn() && isGroupMember(resource.data.groupId);
      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid
        && isGroupMember(request.resource.data.groupId);
      allow update: if signedIn() && resource.data.creatorId == request.auth.uid;
      allow delete: if signedIn() && (
        resource.data.creatorId == request.auth.uid
        || isGroupOwner(resource.data.groupId)
      );
    }

    match /settlements/{settlementId} {
      allow read: if signedIn() && isGroupMember(resource.data.groupId);
      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.fromUserId == request.auth.uid
        && isGroupMember(request.resource.data.groupId);
      allow update: if signedIn() && resource.data.creatorId == request.auth.uid;
      allow delete: if signedIn() && (
        resource.data.creatorId == request.auth.uid
        || isGroupOwner(resource.data.groupId)
      );
    }
  }
}
