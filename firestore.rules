rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isGroupOwner(groupId) {
      return signedIn()
        && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid;
    }

    function isGroupMember(groupId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.email == resource.data.email
        && request.resource.data.uscId == resource.data.uscId;
      allow delete: if false;
    }

    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if signedIn() && (
        // Owner edits membership / details (ownerId stays the same).
        (resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId)
        // Non-owner leaves the group (removes only themselves).
        || (
          request.auth.uid != resource.data.ownerId
          && request.auth.uid in resource.data.memberIds
          && !(request.auth.uid in request.resource.data.memberIds)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.name == resource.data.name
          && request.resource.data.description == resource.data.description
        )
        // Self-join after accepting a group invite (adds only yourself).
        || (
          !(request.auth.uid in resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.name == resource.data.name
          && request.resource.data.description == resource.data.description
        )
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /expenses/{expenseId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid
        && isGroupMember(request.resource.data.groupId);
      allow update: if signedIn() && resource.data.creatorId == request.auth.uid;
      allow delete: if signedIn() && (
        resource.data.creatorId == request.auth.uid
        || isGroupOwner(resource.data.groupId)
      );
    }

    match /settlements/{settlementId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.fromUserId == request.auth.uid
        && isGroupMember(request.resource.data.groupId);
      allow update: if signedIn() && resource.data.creatorId == request.auth.uid;
      allow delete: if signedIn() && (
        resource.data.creatorId == request.auth.uid
        || isGroupOwner(resource.data.groupId)
      );
    }

    match /friendships/{friendshipId} {
      allow get: if signedIn() && (
        resource == null
        || request.auth.uid in resource.data.userIds
      );
      allow list: if signedIn() && request.auth.uid in resource.data.userIds;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.userIds
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.userIds.size() == 2;
      allow update: if signedIn()
        && request.auth.uid in resource.data.userIds
        && request.resource.data.userIds == resource.data.userIds;
      allow delete: if signedIn() && request.auth.uid in resource.data.userIds;
    }

    match /requests/{requestId} {
      allow get: if signedIn() && (
        resource == null
        || request.auth.uid == resource.data.fromUserId
        || request.auth.uid == resource.data.toUserId
      );
      allow list: if signedIn() && (
        request.auth.uid == resource.data.fromUserId
        || request.auth.uid == resource.data.toUserId
      );
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.fromUserId
        && request.resource.data.status == 'PENDING'
        && request.resource.data.fromUserId != request.resource.data.toUserId;
      // Recipient may accept or deny a pending request; core fields stay fixed.
      allow update: if signedIn()
        && request.auth.uid == resource.data.toUserId
        && resource.data.status == 'PENDING'
        && request.resource.data.status in ['ACCEPTED', 'DENIED']
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toUserId == resource.data.toUserId
        && request.resource.data.type == resource.data.type
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.groupName == resource.data.groupName
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }
  }
}
